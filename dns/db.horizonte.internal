; Zona del dominio de laboratorio de la U.E. Horizonte (Actividad 4).
$TTL 300
@   IN SOA ns1.horizonte.internal. hostmaster.horizonte.internal. ( 2026102401 3600 900 604800 300 )
    IN NS  ns1.horizonte.internal.
ns1     IN A 10.44.0.2
mail    IN A 10.44.0.25
cliente IN A 10.44.0.50
imap    IN CNAME mail
smtp    IN CNAME mail
; Correo: MX, SPF y DMARC (la clave publica DKIM la inserta scripts/publicar_dkim.sh)
@       IN MX 10 mail.horizonte.internal.
@       IN TXT "v=spf1 mx -all"
_dmarc  IN TXT "v=DMARC1; p=quarantine; rua=mailto:dmarc@horizonte.internal; adkim=s; aspf=s"
; Autodescubrimiento de clientes de correo (RFC 6186)
_imaps._tcp       IN SRV 0 1 993 mail.horizonte.internal.
_submission._tcp  IN SRV 0 1 587 mail.horizonte.internal.
$INCLUDE /etc/bind/zonas/dkim.horizonte.internal.inc
