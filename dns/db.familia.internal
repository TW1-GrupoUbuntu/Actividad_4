; Segundo dominio de laboratorio (la "otra organizacion" a la que se escribe y de la que se recibe).
$TTL 300
@   IN SOA ns1.horizonte.internal. hostmaster.familia.internal. ( 2026102401 3600 900 604800 300 )
    IN NS  ns1.horizonte.internal.
mail    IN A 10.44.0.26
@       IN MX 10 mail.familia.internal.
@       IN TXT "v=spf1 mx -all"
_dmarc  IN TXT "v=DMARC1; p=quarantine; rua=mailto:dmarc@familia.internal; adkim=s; aspf=s"
$INCLUDE /etc/bind/zonas/dkim.familia.internal.inc
